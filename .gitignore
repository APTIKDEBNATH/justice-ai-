# Secrets, Environment Variables & API Keys (NEVER COMMIT)
.env
*.env
*.key
*.pem
secrets/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
