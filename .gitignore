lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Local Databases, Vector Stores & Logs (Isolated per environment)
data/*.db
data/chroma_db/
temp_payload.json
temp_*.html
temp_*.pdf
test_*.pdf
*.log

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
